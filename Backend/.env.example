# ===================================================
# Future Focus Classes LMS - Backend Configuration
# ===================================================

PORT=3000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/future_focus_lms?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=future_focus_super_secret_production_ready_jwt_key_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Nodemailer / SMTP Configuration (Optional, Falls back to safe mock mode)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="Future Focus Classes <admissions@futurefocusclasses.com>"

# Payment Gateway (Razorpay - Optional, Built-in test mock mode enabled)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Cloud Storage (Cloudinary - Optional, Fallback local paths provided)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Service Microservice (Optional FastAPI Service Gateway)
AI_SERVICE_URL=http://localhost:8000
